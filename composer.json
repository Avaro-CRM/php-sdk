{
    "name": "avaro/sdk",
    "description": "PHP SDK for the Avaro API v3: shop catalog, customer sign-in, quotes, orders, invoices and hotel booking requests",
    "type": "library",
    "license": "MIT",
    "keywords": ["avaro", "api", "sdk", "shop", "b2b", "hotel", "psr-18"],
    "homepage": "https://github.com/Avaro-CRM/php-sdk",
    "authors": [
        {"name": "Jan Habbo Brüning", "homepage": "https://avaro.de"}
    ],
    "require": {
        "php": "^8.2",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/yaml": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {"Avaro\\Sdk\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Avaro\\Sdk\\Tests\\": "tests/"}
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "check": ["@stan", "@test"]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {"dev-main": "1.x-dev"}
    },
    "minimum-stability": "stable"
}
